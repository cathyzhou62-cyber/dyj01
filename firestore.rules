rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || userId == 'guest_user';
    }

    function isAuthorized(userId) {
      return (isSignedIn() && request.auth.uid == userId) || userId == 'guest_user';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMistake(data) {
      return data.userId is string &&
             data.originalQuestion is string &&
             data.originalQuestion.size() <= 10000 &&
             data.knowledgePoint is string &&
             data.knowledgePoint.size() <= 500 &&
             (data.createdAt is timestamp || data.createdAt == null);
    }

    match /mistakes/{mistakeId} {
      allow get: if isAuthorized(resource.data.userId);
      allow list: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId) &&
                      isValidMistake(request.resource.data) &&
                      isValidId(mistakeId);
      allow update: if isAuthorized(resource.data.userId) &&
                      isAuthorized(request.resource.data.userId) &&
                      isValidMistake(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originalQuestion', 'originalAnalysis', 'knowledgePoint', 'variations']);
      allow delete: if isAuthorized(resource.data.userId);
    }
  }
}
